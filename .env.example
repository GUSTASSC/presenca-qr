PORT=3000
HOST=0.0.0.0
# Configure HTTPS no proxy e habilite cookies seguros em produção.
COOKIE_SECURE=false
# Obrigatório para criar o primeiro professor fora da demonstração.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Professor

# Conexão exclusiva do servidor com Supabase. Copie Connect > Transaction pooler.
# Deixe [YOUR-PASSWORD] na URL e informe a senha separadamente abaixo.
DATABASE_URL=
DATABASE_PASSWORD=
DATABASE_SSL_CA_PATH=
# Na Vercel, use o conteúdo PEM do certificado em vez de um caminho local.
DATABASE_SSL_CA=

# sqlite para retornar ao banco local; postgres após db:migrate e validação.
DB_PROVIDER=sqlite
DATABASE_SCHEMA=presenca
# Criados por db:migrate; credenciais exclusivas do servidor.
DATABASE_APP_USER=
DATABASE_APP_PASSWORD=

# Chave aleatória de 32 bytes em base64url, somente no servidor. Não rotacione sem migração.
IDENTITY_KEY=
APP_ORIGIN=https://presenca-qr.vercel.app
# Recuperação por e-mail (remetente verificado no Resend).
RESEND_API_KEY=
RESET_EMAIL_FROM=
# Recuperação por SMS (opcional, requer conta e remetente Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SUPABASE_AUTH_ENABLED=false
SUPABASE_RECOVERY_ENABLED=false
SUPABASE_URL=
# Server only: never prefix these variables with NEXT_PUBLIC_ or expose through API.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
